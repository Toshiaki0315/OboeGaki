<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 日本語のアプリだと macOS に伝える（実機 2026-09-11）。これが無いと
	     AppKit は「英語のアプリ」と見て、編集メニューの AutoFill/Dictation や
	     保存・印刷の窓を英語で出す。Resources/ja.lproj と対で効く -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
		<string>en</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<!-- 文字起こし（ADR-0070）。同梱の oboegaki-transcribe が macOS の音声認識を使う。
	     この Mac の中だけで行う。許可を求められたときの説明（無いと落とされることがある） -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>音声・動画を文字起こしして議事録を作るために、この Mac の中の音声認識を使います。音声は外へ送りません。</string>
</dict>
</plist>
